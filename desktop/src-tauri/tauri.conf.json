{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UNCONFIGURED Station Archive",
  "version": "1.0.0",
  "identifier": "org.example.stationarchive",
  "build": {
    "frontendDist": "../../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Community radio on-demand archive",
    "longDescription": "Search, stream, and browse a community radio station's on-demand broadcast archive. Set per station in stations/<slug>.json.",
    "copyright": "Set per station in stations/<slug>.json.",
    "macOS": {
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
