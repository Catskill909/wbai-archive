# Copy to .env for local runs, or paste into Coolify's Environment Variables.
# Every value here has a working default — an empty environment runs the app.
# `.env` and `.env.*` are gitignored; this file is the only one committed.

# Port the server listens on. Coolify maps its proxy to this.
PORT=8080

# Which station this deployment is. Stamped into data files so a volume that is
# restored or attached to the wrong app is caught rather than silently merged.
STATION_ID=wbai

# ---------------------------------------------------------------- storage
#
# Everything the server persists lives under this ONE directory, and it is the
# same string as the volume's mount path. In production set the mount in
# Coolify -> Storages -> Volume Mount -> /app/data, and leave this at its
# default. See docs/DEPLOYMENT.md; declaring a volume in docker-compose.yml has
# been observed NOT to be honoured.
#
# Local: this is ./data in the repo, an ordinary directory that survives
# everything. Production: it is a mount point, and whether it survives a
# redeploy is a fact only /healthz can report. Never conclude anything about
# production storage from a local run.
DATA_DIR=/app/data

# Per-file overrides. Only needed if you want the caches somewhere other than
# under DATA_DIR — leave them unset otherwise.
# SHOWINFO_PATH=/app/data/showinfo.json
# PROGRAMS_PATH=/app/data/programs.json
# FEEDS_PATH=/app/data/feeds.json

# Read-only starting set for the show-info cache, baked into the image. Lives
# OUTSIDE DATA_DIR on purpose: a mounted volume shadows whatever the image put
# at that path, so a seed placed there would never be read.
# SEED_PATH=/app/seed/showinfo.json

# ----------------------------------------------------------------- studio
#
# The password-gated station view at /studio. See docs/admin-page.md.
#
# UNSET = THE FEATURE DOES NOT EXIST. Not "returns 403" — the routes are never
# registered, so /studio falls through like any other unknown path and gives a
# scanner nothing. That is the correct default for a fork of this template, so
# only set this on deployments that actually want it.
#
# One shared password for everyone who needs in. Use 12+ characters; the server
# warns in its log if it is shorter. Rotating it signs everybody out, which is
# the only revocation mechanism there is (sessions are stateless — signing out
# clears your own browser, it cannot invalidate a cookie already copied off a
# device).
# STUDIO_PASSWORD=

# Optional. Signs session cookies; defaults to a key derived from the password
# above, which is what makes a password change revoke existing sessions. Set it
# explicitly only if you want sessions to SURVIVE a password change.
# STUDIO_SECRET=

# Optional. Session lifetime in hours; default 12 — a working day, short enough
# that a forgotten laptop expires on its own.
# STUDIO_SESSION_HOURS=12

# ------------------------------------------------------------------ usage
#
# Counters for plays, live tune-ins, page views, searches and shares. There is
# no event log, no cookie, no session and no stored or hashed IP — nothing links
# two events to the same person, so "unique listeners" is not a number this app
# can produce. Search volume is counted; the words typed are never sent.
#
# Set to `off` and the ingest route is never registered: nothing is counted at
# all. Viewing the numbers is separate — that is STUDIO_PASSWORD above.
USAGE_TRACKING=on

NODE_ENV=production
